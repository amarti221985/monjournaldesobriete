# Copier ce fichier vers .env.local puis renseigner les valeurs.
# Ne JAMAIS commiter .env.local ni aucun fichier contenant de vraies clés.

# --- Supabase (Dashboard > Project Settings > API Keys) ---------------------
# URL du projet, ex. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (sb_publishable_...). Conçue pour le navigateur : les données
# restent protégées par les politiques RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Application ------------------------------------------------------------
# URL publique de l'application. Optionnel en local (défaut http://localhost:3000).
# En production : https://ton-domaine.com
NEXT_PUBLIC_SITE_URL=

# --- Bilans intelligents (facultatif, côté serveur uniquement) ---------------
# Sans clé, la fonction IA est indisponible et aucune donnée n'est envoyée.
# Ne JAMAIS préfixer par NEXT_PUBLIC_ ni commiter la valeur.
ANTHROPIC_API_KEY=
# Modèle (défaut claude-opus-5)
AI_MODEL=

# --- Avis bêta : notification par courriel (facultatif, Resend, côté serveur) ---
# Sans ces valeurs, les avis restent enregistrés dans Supabase (table beta_feedback).
# Clé API Resend (re_...). Ne JAMAIS préfixer par NEXT_PUBLIC_.
RESEND_API_KEY=
# Adresse qui reçoit les avis (avec l'expéditeur par défaut de Resend : l'adresse du compte Resend).
FEEDBACK_NOTIFY_EMAIL=
# Expéditeur (facultatif ; seulement avec un domaine vérifié dans Resend).
FEEDBACK_FROM_EMAIL=

# --- Secrets Supabase -----------------------------------------------------------
# Aucun secret Supabase n'est requis : la suppression de compte passe par la
# fonction SQL delete_my_account() (voir docs/SECURITY.md). Ne jamais ajouter de
# clé service_role / sb_secret_, et jamais avec le préfixe NEXT_PUBLIC_.
