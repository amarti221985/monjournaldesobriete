# Copier ce fichier vers .env.local puis renseigner les valeurs.
# Ne JAMAIS commiter .env.local ni aucun fichier contenant de vraies clés.

# --- Supabase (Dashboard > Project Settings > API Keys) ---------------------
# URL du projet, ex. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (sb_publishable_...). Conçue pour le navigateur : les données
# restent protégées par les politiques RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Application ------------------------------------------------------------
# URL publique de l'application. Optionnel en local (défaut http://localhost:3000).
# En production : https://ton-domaine.com
NEXT_PUBLIC_SITE_URL=

# --- Secrets serveur ----------------------------------------------------------
# Aucun secret serveur n'est requis pour l'instant.
# SUPABASE_SERVICE_ROLE_KEY (ou clé secrète sb_secret_...) ne sera ajoutée
# qu'au sprint qui en aura besoin (suppression de compte). Elle ne doit JAMAIS
# être préfixée NEXT_PUBLIC_ ni utilisée côté client.
